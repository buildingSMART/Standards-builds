msgid "IfcAnnotation"
msgstr "Annotation"

msgid "IfcAnnotation_DEFINITION"
msgstr "An annotation is an information element within the geometric (and spatial) context of a project, that adds a note or meaning to the objects which constitutes the project model. Annotations include additional points, curves, text, dimensioning, hatching and other forms of graphical notes. It also includes virtual or symbolic representations of additional model components, not representing products or spatial structures, such as survey points and lines, contour lines or similar."

msgid "SetbackDistance"
msgstr "Setback Distance"

msgid "SetbackDistance_DEFINITION"
msgstr "Setback distance from the point of connection on the major element along the axis of the minor element (e.g. distance from a public road at which the line of sigfht is measured."

msgid "SetbackDistance_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "VisibleAngleLeft"
msgstr "Visible Angle Left"

msgid "VisibleAngleLeft_DEFINITION"
msgstr "Angle of visibility to the left of the access."

msgid "VisibleAngleLeft_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositivePlaneAngleMeasure as value."

msgid "VisibleAngleRight"
msgstr "Visible Angle Right"

msgid "VisibleAngleRight_DEFINITION"
msgstr "Angle of visibility to the right of the access."

msgid "VisibleAngleRight_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositivePlaneAngleMeasure as value."

msgid "RoadVisibleDistanceLeft"
msgstr "Road Visible Distance Left"

msgid "RoadVisibleDistanceLeft_DEFINITION"
msgstr "Distance visible to the left of the access."

msgid "RoadVisibleDistanceLeft_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "RoadVisibleDistanceRight"
msgstr "Road Visible Distance Right"

msgid "RoadVisibleDistanceRight_DEFINITION"
msgstr "Distance visible to the right of the access."

msgid "RoadVisibleDistanceRight_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "SoundScale"
msgstr "Sound Scale"

msgid "SoundScale_DEFINITION"
msgstr "The reference sound scale.Decibels in an A-weighted scale;Decibels in an B-weighted scale;Decibels in an C-weighted scale;Noise criteria;Noise rating"

msgid "SoundScale_DBA"
msgstr "Dba: Decibels In An A-weighted Scale Dbb: Decibels In An B-weighted Scale Dbc: Decibels In An C-weighted Scale Nc: Noise Criteria Nr: Noise Rating"

msgid "SoundScale_DBB"
msgstr "Dba: Decibels In An A-weighted Scale Dbb: Decibels In An B-weighted Scale Dbc: Decibels In An C-weighted Scale Nc: Noise Criteria Nr: Noise Rating"

msgid "SoundScale_DBC"
msgstr "Dba: Decibels In An A-weighted Scale Dbb: Decibels In An B-weighted Scale Dbc: Decibels In An C-weighted Scale Nc: Noise Criteria Nr: Noise Rating"

msgid "SoundScale_NC"
msgstr "The Reference [[Sound]] Scale"

msgid "SoundScale_NR"
msgstr "Dba: Decibels In An A-weighted Scale Dbb: Decibels In An B-weighted Scale Dbc: Decibels In An C-weighted Scale Nc: Noise Criteria Nr: Noise Rating"

msgid "SoundFrequency"
msgstr "Sound Frequency"

msgid "SoundFrequency_DEFINITION"
msgstr "List of nominal sound frequencies, correlated to the [[SoundPressure]] time series values (IfcTimeSeries.ListValues)."

msgid "SoundPressure"
msgstr "Sound Pressure"

msgid "SoundPressure_DEFINITION"
msgstr "A time series of sound pressure values measured in decibels at a reference pressure of 20 microPascals for the referenced octave band frequency. Each value in IfcTimeSeries.ListValues is correlated to the sound frequency at the same position within SoundFrequencies."

msgid "SoundPressure_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "IfcElement"
msgstr "Element"

msgid "IfcElement_DEFINITION"
msgstr "An element is a generalization of all components that make up a facility."

msgid "IfcLinearElement"
msgstr "Linear Element"

msgid "IfcLinearElement_DEFINITION"
msgstr "A generalization of all linear elements that are parts of an alignment."

msgid "IfcPort"
msgstr "Port"

msgid "IfcPort_DEFINITION"
msgstr "A port provides the means for an element to connect to other elements."

msgid "IfcPositioningElement"
msgstr "Positioning Element"

msgid "IfcPositioningElement_DEFINITION"
msgstr "An abstract entity definition used to position other elements."

msgid "IfcSpatialElement"
msgstr "Spatial Element"

msgid "IfcSpatialElement_DEFINITION"
msgstr "A spatial element is the generalization of all spatial elements that might be used to define a spatial structure or to define spatial zones."

msgid "CoolingAirFlowRate"
msgstr "Cooling Air Flow Rate"

msgid "CoolingAirFlowRate_DEFINITION"
msgstr "Cooling air flow rate in the space."

msgid "CoolingAirFlowRate_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "HeatingAirFlowRate"
msgstr "Heating Air Flow Rate"

msgid "HeatingAirFlowRate_DEFINITION"
msgstr "Heating air flow rate in the space."

msgid "HeatingAirFlowRate_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "VentilationAirFlowRateHistory"
msgstr "Ventilation Air Flow Rate History"

msgid "VentilationAirFlowRateHistory_DEFINITION"
msgstr "[[Ventilation]] air flow rate in the space."

msgid "VentilationAirFlowRateHistory_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "ExhaustAirFlowRate"
msgstr "Exhaust Air Flow Rate"

msgid "ExhaustAirFlowRate_DEFINITION"
msgstr "Design exhaust air flow rate for the space."

msgid "ExhaustAirFlowRate_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "SpaceTemperatureHistory"
msgstr "Space Temperature History"

msgid "SpaceTemperatureHistory_DEFINITION"
msgstr "[[Temperature]] of the space."

msgid "SpaceTemperatureHistory_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "SpaceRelativeHumidity"
msgstr "Space Relative Humidity"

msgid "SpaceRelativeHumidity_DEFINITION"
msgstr "The relative humidity of the space."

msgid "SpaceRelativeHumidity_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "IsExternal"
msgstr "Is External"

msgid "IsExternal_DEFINITION"
msgstr "Indication whether the element is designed for use in the exterior (TRUE) or not (FALSE). If (TRUE) it is an external element and faces the outside of the building."

msgid "IsExternal_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "GrossPlannedArea"
msgstr "Gross Planned Area"

msgid "GrossPlannedArea_DEFINITION"
msgstr "Total planned gross area of the spatial structure element. Used for programming the spatial structure element."

msgid "GrossPlannedArea_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcAreaMeasure as value."

msgid "NetPlannedArea"
msgstr "Net Planned Area"

msgid "NetPlannedArea_DEFINITION"
msgstr "Total planned net area of the object. Used for programming the object."

msgid "NetPlannedArea_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcAreaMeasure as value."

msgid "PubliclyAccessible"
msgstr "Publicly Accessible"

msgid "PubliclyAccessible_DEFINITION"
msgstr "Indication whether this space (in case of e.g., a toilet) is designed to serve as a publicly accessible space, e.g., for a public toilet (TRUE) or not (FALSE)."

msgid "PubliclyAccessible_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "HandicapAccessible"
msgstr "Handicap Accessible"

msgid "HandicapAccessible_DEFINITION"
msgstr "Indication that this object is designed to be accessible by the handicapped. Set to (TRUE) if this object is rated as handicap accessible according to the local building codes, otherwise (FALSE). It is giving according to the requirements of the national building code."

msgid "HandicapAccessible_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "FloorCovering"
msgstr "Floor Covering"

msgid "FloorCovering_DEFINITION"
msgstr "Label to indicate the material or finish of the space flooring. The label is used for room book information and often displayed in room stamp. The material information is provided in absence of an [[IfcCovering]] (type=FLOORING) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence."

msgid "FloorCovering_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "FloorCoveringThickness"
msgstr "Floor Covering Thickness"

msgid "FloorCoveringThickness_DEFINITION"
msgstr "[[Thickness]] of the material layer(s) for the space flooring. The thickness information is provided in absence of an [[IfcCovering]] (type=FLOORING) object with own shape representation. In cases of inconsistency between the geometric parameters of an assigned [[IfcCovering]] and this attached property, the geometric parameters take precedence."

msgid "FloorCoveringThickness_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "WallCovering"
msgstr "Wall Covering"

msgid "WallCovering_DEFINITION"
msgstr "Label to indicate the material or finish of the space cladding. The label is used for room book information and often displayed in room stamp. The material information is provided in absence of an [[IfcCovering]] (type=CLADDING) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence."

msgid "WallCovering_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "WallCoveringThickness"
msgstr "Wall Covering Thickness"

msgid "WallCoveringThickness_DEFINITION"
msgstr "[[Thickness]] of the material layer(s) for the space cladding. The thickness information is provided in absence of an [[IfcCovering]] (type=CLADDING) object with own shape representation. In cases of inconsistency between the geometric parameters of an assigned [[IfcCovering]] and this attached property, the geometric parameters take precedence."

msgid "WallCoveringThickness_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "CeilingCovering"
msgstr "Ceiling Covering"

msgid "CeilingCovering_DEFINITION"
msgstr "Label to indicate the material or finish of the space ceiling. The label is used for room book information and often displayed in room stamp. The material information is provided in absence of an [[IfcCovering]] (type=[[CEILING]]) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence."

msgid "CeilingCovering_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "CeilingCoveringThickness"
msgstr "Ceiling Covering Thickness"

msgid "CeilingCoveringThickness_DEFINITION"
msgstr "[[Thickness]] of the material layer(s) for the space ceiling. The thickness information is provided in absence of an [[IfcCovering]] (type=[[CEILING]]) object with own shape representation. In cases of inconsistency between the geometric parameters of an assigned [[IfcCovering]] and this attached property, the geometric parameters take precedence."

msgid "CeilingCoveringThickness_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "SkirtingBoard"
msgstr "Skirting Board"

msgid "SkirtingBoard_DEFINITION"
msgstr "Label to indicate the material or construction of the skirting board around the space flooring. The label is used for room book information. The material information is provided in absence of an [[IfcCovering]] (type=SKIRTINGBOARD) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence."

msgid "SkirtingBoard_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "SkirtingBoardHeight"
msgstr "Skirting Board Height"

msgid "SkirtingBoardHeight_DEFINITION"
msgstr "[[Height]] of the skirting board. The height information is provided in absence of an [[IfcCovering]] (type=SKIRTINGBOARD) object with own shape representation and material assignment. In case of inconsistency the height assigned to [[IfcCovering]] elements takes precedence."

msgid "SkirtingBoardHeight_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "Molding"
msgstr "Molding"

msgid "Molding_DEFINITION"
msgstr "Label to indicate the material or construction of the molding around the space ceiling. The label is used for room book information. The material information is provided in absence of an [[IfcCovering]] (type=MOLDING) object with own shape representation and material assignment. In case of inconsistency the material assigned to [[IfcCovering]] elements takes precedence."

msgid "Molding_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "MoldingHeight"
msgstr "Molding Height"

msgid "MoldingHeight_DEFINITION"
msgstr "[[Height]] of the molding. The height information is provided in absence of an [[IfcCovering]] (type=MOLDING) object with own shape representation and material assignment. In case of inconsistency the height assigned to [[IfcCovering]] elements takes precedence."

msgid "MoldingHeight_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "ConcealedFlooring"
msgstr "Concealed Flooring"

msgid "ConcealedFlooring_DEFINITION"
msgstr "Indication whether this space is designed to have a concealed flooring space (TRUE) or not (FALSE). A concealed flooring space is normally meant to be the space beneath a raised floor."

msgid "ConcealedFlooring_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "ConcealedFlooringOffset"
msgstr "Concealed Flooring Offset"

msgid "ConcealedFlooringOffset_DEFINITION"
msgstr "Distance between the floor slab and the floor covering, often used for cables and other installations. Often referred to as raised flooring."

msgid "ConcealedFlooringOffset_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcNonNegativeLengthMeasure as value."

msgid "ConcealedCeiling"
msgstr "Concealed Ceiling"

msgid "ConcealedCeiling_DEFINITION"
msgstr "Indication whether this space is designed to have a concealed flooring space (TRUE) or not (FALSE). A concealed ceiling space is normally meant to be the space between a slab and a ceiling."

msgid "ConcealedCeiling_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "ConcealedCeilingOffset"
msgstr "Concealed Ceiling Offset"

msgid "ConcealedCeilingOffset_DEFINITION"
msgstr "Distance between the upper floor slab and the suspended ceiling, often used for distribution systems. Often referred to as plenum."

msgid "ConcealedCeilingOffset_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcNonNegativeLengthMeasure as value."

msgid "FireRiskFactor"
msgstr "Fire Risk Factor"

msgid "FireRiskFactor_DEFINITION"
msgstr "Fire Risk factor assigned to the space according to local building regulations. It defines the fire risk of the space at several levels of fire hazard."

msgid "FireRiskFactor_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "FlammableStorage"
msgstr "Flammable Storage"

msgid "FlammableStorage_DEFINITION"
msgstr "Indication whether the space is intended to serve as a storage of flammable material (which is regarded as such by the presiding building code. (TRUE) indicates yes, (FALSE) otherwise."

msgid "FlammableStorage_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "FireExit"
msgstr "Fire Exit"

msgid "FireExit_DEFINITION"
msgstr "Indication whether this object is designed to serve as an exit in the case of fire (TRUE) or not (FALSE)."

msgid "FireExit_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "SprinklerProtection"
msgstr "Sprinkler Protection"

msgid "SprinklerProtection_DEFINITION"
msgstr "Indication whether this object is sprinkler protected (TRUE) or not (FALSE)."

msgid "SprinklerProtection_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "SprinklerProtectionAutomatic"
msgstr "Sprinkler Protection Automatic"

msgid "SprinklerProtectionAutomatic_DEFINITION"
msgstr "Indication whether this object has an automatic sprinkler protection (TRUE) or not (FALSE).; It should only be given, if the property '[[SprinklerProtection]]' is set to TRUE."

msgid "SprinklerProtectionAutomatic_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "AirPressurization"
msgstr "Air Pressurization"

msgid "AirPressurization_DEFINITION"
msgstr "Indication whether the space is required to have pressurized air (TRUE) or not (FALSE)."

msgid "AirPressurization_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "TemperatureSetPoint"
msgstr "Temperature Set Point"

msgid "TemperatureSetPoint_DEFINITION"
msgstr "The temperature setpoint range and default setpoint."

msgid "TemperatureSetPoint_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "TemperatureMax"
msgstr "Temperature Max"

msgid "TemperatureMax_DEFINITION"
msgstr "Maximal temperature of the space or zone, that is required from user/designer view point. If no summer or winter space temperature requirements are given, it applies all year, otherwise for the intermediate period."

msgid "TemperatureMax_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "TemperatureMin"
msgstr "Temperature Min"

msgid "TemperatureMin_DEFINITION"
msgstr "Minimal temperature of the space or zone, that is required from user/designer view point. If no summer or winter space temperature requirements are given, it applies all year, otherwise for the intermediate period."

msgid "TemperatureMin_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "TemperatureSummerMax"
msgstr "Temperature Summer Max"

msgid "TemperatureSummerMax_DEFINITION"
msgstr "Maximal temperature of the space or zone for the hot (summer) period, that is required from user/designer view point and provided as requirement for cooling."

msgid "TemperatureSummerMax_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "TemperatureSummerMin"
msgstr "Temperature Summer Min"

msgid "TemperatureSummerMin_DEFINITION"
msgstr "Minimal temperature of the space or zone for the hot (summer) period, that is required from user/designer view point and provided as requirement for cooling."

msgid "TemperatureSummerMin_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "TemperatureWinterMax"
msgstr "Temperature Winter Max"

msgid "TemperatureWinterMax_DEFINITION"
msgstr "Maximal temperature of the space or zone for the cold (winter) period, that is required from user/designer view point and provided as requirement for heating."

msgid "TemperatureWinterMax_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "TemperatureWinterMin"
msgstr "Temperature Winter Min"

msgid "TemperatureWinterMin_DEFINITION"
msgstr "Minimal temperature of the space or zone for the cold (winter) period, that is required from user/designer view point and provided as requirement for heating."

msgid "TemperatureWinterMin_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermodynamicTemperatureMeasure as value."

msgid "HumiditySetPoint"
msgstr "Humidity Set Point"

msgid "HumiditySetPoint_DEFINITION"
msgstr "Humidity of the space or zone that is required from user/designer view point. If no summer or winter space humidity requirements are given, it applies all year, otherwise for the intermediate period. Provide this property, if no humidity range (Min-Max) is available."

msgid "HumiditySetPoint_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "HumidityMax"
msgstr "Humidity Max"

msgid "HumidityMax_DEFINITION"
msgstr "Maximal permitted humidity of the space or zone that is required from user/designer view point. If no summer or winter space humidity requirements are given, it applies all year, otherwise for the intermediate period."

msgid "HumidityMax_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "HumidityMin"
msgstr "Humidity Min"

msgid "HumidityMin_DEFINITION"
msgstr "Minimal permitted humidity of the space or zone that is required from user/designer view point. If no summer or winter space humidity requirements are given, it applies all year, otherwise for the intermediate period."

msgid "HumidityMin_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "HumiditySummer"
msgstr "Humidity Summer"

msgid "HumiditySummer_DEFINITION"
msgstr "Humidity of the space or zone for the hot (summer) period, that is required from user/designer view point and provided as requirement for cooling."

msgid "HumiditySummer_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "HumidityWinter"
msgstr "Humidity Winter"

msgid "HumidityWinter_DEFINITION"
msgstr "Humidity of the space or zone for the cold (winter) period that is required from user/designer view point and provided as requirement for heating."

msgid "HumidityWinter_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "DiscontinuedHeating"
msgstr "Discontinued Heating"

msgid "DiscontinuedHeating_DEFINITION"
msgstr "Indication whether discontinued heating is required/desirable from user/designer view point. (TRUE) if yes, (FALSE) otherwise."

msgid "DiscontinuedHeating_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "NaturalVentilation"
msgstr "Natural Ventilation"

msgid "NaturalVentilation_DEFINITION"
msgstr "Indication whether the space is required to have natural ventilation (TRUE), or not (FALSE)."

msgid "NaturalVentilation_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "NaturalVentilationRate"
msgstr "Natural Ventilation Rate"

msgid "NaturalVentilationRate_DEFINITION"
msgstr "Indication of the requirement of a particular natural air ventilation rate, given in air changes per hour."

msgid "NaturalVentilationRate_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcNumericMeasure as value."

msgid "MechanicalVentilation"
msgstr "Mechanical Ventilation"

msgid "MechanicalVentilation_DEFINITION"
msgstr "Indication whether the space is required to have mechanical ventilation (TRUE), or not (FALSE)."

msgid "MechanicalVentilation_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "MechanicalVentilationRate"
msgstr "Mechanical Ventilation Rate"

msgid "MechanicalVentilationRate_DEFINITION"
msgstr "Indication of the requirement of a particular mechanical air ventilation rate, given in air changes per hour."

msgid "MechanicalVentilationRate_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcNumericMeasure as value."

msgid "AirConditioning"
msgstr "Air Conditioning"

msgid "AirConditioning_DEFINITION"
msgstr "Indication whether this space requires air conditioning provided (TRUE) or not (FALSE)."

msgid "AirConditioning_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "AirConditioningCentral"
msgstr "Air Conditioning Central"

msgid "AirConditioningCentral_DEFINITION"
msgstr "Indication whether the space requires a central air conditioning provided (TRUE) or not (FALSE).; It should only be given, if the property '[[AirConditioning]]' is set to TRUE."

msgid "AirConditioningCentral_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "AirHandlingName"
msgstr "Air Handling Name"

msgid "AirHandlingName_DEFINITION"
msgstr "The name of the air side system. IfcRelServicesBuildings should be used to reference the correct AirHandlingSystem ([[IfcSystem]])"

msgid "AirHandlingName_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "ArtificialLighting"
msgstr "Artificial Lighting"

msgid "ArtificialLighting_DEFINITION"
msgstr "Indication whether this space requires artificial lighting (as natural lighting would be not sufficient). (TRUE) indicates yes (FALSE) otherwise."

msgid "ArtificialLighting_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "Illuminance"
msgstr "Illuminance"

msgid "Illuminance_DEFINITION"
msgstr "Required average illuminance value for this space."

msgid "Illuminance_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcIlluminanceMeasure as value."

msgid "OccupancyType"
msgstr "Occupancy Type"

msgid "OccupancyType_DEFINITION"
msgstr "Occupancy type for this object.; It is defined according to the presiding national building code."

msgid "OccupancyType_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "OccupancyNumber"
msgstr "Occupancy Number"

msgid "OccupancyNumber_DEFINITION"
msgstr "Number of people required for the activity assigned to this space."

msgid "OccupancyNumber_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcCountMeasure as value."

msgid "OccupancyNumberPeak"
msgstr "Occupancy Number Peak"

msgid "OccupancyNumberPeak_DEFINITION"
msgstr "Maximal number of people required for the activity assigned to this space in peak time."

msgid "OccupancyNumberPeak_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcCountMeasure as value."

msgid "OccupancyTimePerDay"
msgstr "Occupancy Time Per Day"

msgid "OccupancyTimePerDay_DEFINITION"
msgstr "The amount of time during the day that the activity is required within this space."

msgid "OccupancyTimePerDay_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "AreaPerOccupant"
msgstr "Area Per Occupant"

msgid "AreaPerOccupant_DEFINITION"
msgstr "Design occupancy loading for this type of usage assigned to this space."

msgid "AreaPerOccupant_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcAreaMeasure as value."

msgid "MinimumHeadroom"
msgstr "Minimum Headroom"

msgid "MinimumHeadroom_DEFINITION"
msgstr "[[Headroom]] required for the activity assigned to this space."

msgid "MinimumHeadroom_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLengthMeasure as value."

msgid "IsOutlookDesirable"
msgstr "Is Outlook Desirable"

msgid "IsOutlookDesirable_DEFINITION"
msgstr "An indication of whether the outlook is desirable (set TRUE) or not (set FALSE)."

msgid "IsOutlookDesirable_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "AirSideSystemType"
msgstr "Air Side System Type"

msgid "AirSideSystemType_DEFINITION"
msgstr "This enumeration specifies the basic types of possible air side systems (e.g., Constant [[Volume]], Variable [[Volume]], etc.)."

msgid "AirSideSystemType_CONSTANTVOLUME"
msgstr "Constant [[Volume]]"

msgid "AirSideSystemType_CONSTANTVOLUMEBYPASS"
msgstr "Constant [[Volume]] Bypass"

msgid "AirSideSystemType_CONSTANTVOLUMEMULTIPLEZONEREHEAT"
msgstr "Constant [[Volume]] Multiple Zone Reheat"

msgid "AirSideSystemType_CONSTANTVOLUMESINGLEZONE"
msgstr "Constant [[Volume]] Single Zone"

msgid "AirSideSystemType_VARIABLEAIRVOLUME"
msgstr "Variable Air [[Volume]]"

msgid "AirSideSystemType_VARIABLEAIRVOLUMEDUALCONDUIT"
msgstr "Variable Air [[Volume]] Dual Conduit"

msgid "AirSideSystemType_VARIABLEAIRVOLUMEFANPOWERED"
msgstr "Variable Air [[Volume]] Fan Powered"

msgid "AirSideSystemType_VARIABLEAIRVOLUMEINDUCTION"
msgstr "Variable Air [[Volume]] Induction"

msgid "AirSideSystemType_VARIABLEAIRVOLUMEREHEAT"
msgstr "Variable Air [[Volume]] Reheat"

msgid "AirSideSystemType_VARIABLEAIRVOLUMEVARIABLEDIFFUSERS"
msgstr "Variable Air [[Volume]] Variable Diffusers"

msgid "AirSideSystemType_VARIABLEAIRVOLUMEVARIABLETEMPERATURE"
msgstr "Variable Air [[Volume]] Variable [[Temperature]]"

msgid "AirSideSystemType_OTHER"
msgstr "Other"

msgid "AirSideSystemType_NOTKNOWN"
msgstr "Not Known"

msgid "AirSideSystemType_UNSET"
msgstr "Unset"

msgid "AirSideSystemDistributionType"
msgstr "Air Side System Distribution Type"

msgid "AirSideSystemDistributionType_DEFINITION"
msgstr "This enumeration defines the basic types of air side systems (e.g., SingleDuct, DualDuct, Multizone, etc.)."

msgid "AirSideSystemDistributionType_DUALDUCT"
msgstr "Dual Duct"

