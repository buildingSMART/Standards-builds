msgid "IfcAsset"
msgstr "Asset"

msgid "IfcAsset_DEFINITION"
msgstr "An asset is a uniquely identifiable grouping of elements acting as a single entity that has a financial value or that can be operated on as a single unit."

msgid "AssetAccountingType"
msgstr "Asset Accounting Type"

msgid "AssetAccountingType_DEFINITION"
msgstr "Identifies the predefined types of risk from which the type required may be set."

msgid "AssetAccountingType_FIXED"
msgstr "Fixed"

msgid "AssetAccountingType_NONFIXED"
msgstr "Non Fixed"

msgid "AssetAccountingType_OTHER"
msgstr "Other"

msgid "AssetAccountingType_NOTKNOWN"
msgstr "Not Known"

msgid "AssetAccountingType_UNSET"
msgstr "Unset"

msgid "AssetTaxType"
msgstr "Asset Tax Type"

msgid "AssetTaxType_DEFINITION"
msgstr "Identifies the predefined types of taxation group from which the type required may be set."

msgid "AssetTaxType_CAPITALISED"
msgstr "Capitalised"

msgid "AssetTaxType_EXPENSED"
msgstr "Expensed"

msgid "AssetTaxType_OTHER"
msgstr "Other"

msgid "AssetTaxType_NOTKNOWN"
msgstr "Not Known"

msgid "AssetTaxType_UNSET"
msgstr "Unset"

msgid "AssetInsuranceType"
msgstr "Asset Insurance Type"

msgid "AssetInsuranceType_DEFINITION"
msgstr "Identifies the predefined types of insurance rating from which the type required may be set."

msgid "AssetInsuranceType_PERSONAL"
msgstr "Personal"

msgid "AssetInsuranceType_REAL"
msgstr "Real"

msgid "AssetInsuranceType_OTHER"
msgstr "Other"

msgid "AssetInsuranceType_NOTKNOWN"
msgstr "Not Known"

msgid "AssetInsuranceType_UNSET"
msgstr "Unset"

msgid "AssetStatus"
msgstr "Asset Status"

msgid "AssetStatus_DEFINITION"
msgstr "Current status or stage in life cycle."

msgid "AssetStatus_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "AssetUse"
msgstr "Asset Use"

msgid "AssetUse_DEFINITION"
msgstr "General use category of the asset."

msgid "AssetUse_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "IfcInventory"
msgstr "Inventory"

msgid "IfcInventory_DEFINITION"
msgstr "An inventory is a list of items within an enterprise."

msgid "IfcOccupant"
msgstr "Occupant"

msgid "IfcOccupant_DEFINITION"
msgstr "An occupant is a type of actor that defines the form of occupancy of a property."

msgid "IfcFurniture"
msgstr "Furniture"

msgid "IfcFurniture_DEFINITION"
msgstr "Furniture defines complete furnishings such as a table, desk, chair, or cabinet, which may or may not be permanently attached to a building structure."

msgid "Style"
msgstr "Style"

msgid "Style_DEFINITION"
msgstr "[[Description]] of the furniture style."

msgid "Style_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "MainColour"
msgstr "Main Colour"

msgid "MainColour_DEFINITION"
msgstr "The main colour of the furniture of this type."

msgid "MainColour_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "IsBuiltIn"
msgstr "Is Built In"

msgid "IsBuiltIn_DEFINITION"
msgstr "Indicates whether the furniture type is intended to be 'built in' i.e. physically attached to a building or facility (= TRUE) or not i.e. Loose and movable (= FALSE)."

msgid "IsBuiltIn_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "IfcSystemFurnitureElement"
msgstr "System Furniture Element"

msgid "IfcSystemFurnitureElement_DEFINITION"
msgstr "A system furniture element defines components of modular furniture which are not directly placed in a building structure but aggregated inside furniture."

msgid "IsUsed"
msgstr "Is Used"

msgid "IsUsed_DEFINITION"
msgstr "Indicates whether the element is being used in a workstation (= TRUE) or not.(= FALSE)."

msgid "IsUsed_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "GroupCode"
msgstr "Group Code"

msgid "GroupCode_DEFINITION"
msgstr "E.g. panels, worksurfaces, storage, etc."

msgid "GroupCode_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcIdentifier as value."

msgid "Finishing"
msgstr "Finishing"

msgid "Finishing_DEFINITION"
msgstr "The finishing applied to system furniture elements of this type e.g. walnut, fabric."

msgid "Finishing_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

