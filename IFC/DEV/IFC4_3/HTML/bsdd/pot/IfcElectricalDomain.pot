msgid "IfcProtectiveDeviceTrippingUnit"
msgstr "Protective Device Tripping Unit"

msgid "IfcProtectiveDeviceTrippingUnit_DEFINITION"
msgstr "A protective device tripping unit breaks an electrical circuit at a separate breaking unit when a stated electric current that passes through the unit is exceeded."

msgid "IsSelectable"
msgstr "Is Selectable"

msgid "IsSelectable_DEFINITION"
msgstr "Indication whether something can be switched off or not."

msgid "IsSelectable_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "NominalCurrentAdjusted"
msgstr "Nominal Current Adjusted"

msgid "NominalCurrentAdjusted_DEFINITION"
msgstr "An indication if the tripping currents of the short time protection is related to the nominal current multiplied with the actual setting of the current adjustment, if any, of the long time protection part of the protective device, or not."

msgid "NominalCurrentAdjusted_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "ExternalAdjusted"
msgstr "External Adjusted"

msgid "ExternalAdjusted_DEFINITION"
msgstr "An indication if the ground fault protection may be adjusted according to an external current coil or not."

msgid "ExternalAdjusted_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "ReleaseCurrent"
msgstr "Release Current"

msgid "ReleaseCurrent_DEFINITION"
msgstr "The release current in x In for the initial tripping of the S-function."

msgid "ReleaseCurrent_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "ReleaseTime"
msgstr "Release Time"

msgid "ReleaseTime_DEFINITION"
msgstr "The release time in s for the initial tripping of the relevant part. This time indicates that for current lower than the indicated release current, the tripping time will be longer than the indicated release time. The value is given as a mean value."

msgid "ReleaseTime_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "CurrentTolerance1"
msgstr "Current Tolerance 1"

msgid "CurrentTolerance1_DEFINITION"
msgstr "The tolerance for the current of time/current-curve in %."

msgid "CurrentTolerance1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "CurrentToleranceLimit1"
msgstr "Current Tolerance Limit 1"

msgid "CurrentToleranceLimit1_DEFINITION"
msgstr "The time limit in s limiting the application of [[CurrentTolerance1]], if any. If the value is set to 0, the value of the [[CurrentTolerance1]] is valid for the whole time/current-curve."

msgid "CurrentToleranceLimit1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "CurrentTolerance2"
msgstr "Current Tolerance 2"

msgid "CurrentTolerance2_DEFINITION"
msgstr "The tolerance for the current of time/current-curve in % valid for times above CurrentTolereanceLimit1."

msgid "CurrentTolerance2_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "IsCurrentTolerancePositiveOnly"
msgstr "Is Current Tolerance Positive Only"

msgid "IsCurrentTolerancePositiveOnly_DEFINITION"
msgstr "Indication whether the value of [[CurrentTolerance1]] is provided as a positive tolereance only or not. If not, the value is proved as a pluss/minus tolerance."

msgid "IsCurrentTolerancePositiveOnly_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "TimeTolerance1"
msgstr "Time Tolerance 1"

msgid "TimeTolerance1_DEFINITION"
msgstr "The tolerance for the time of time/current-curve in %."

msgid "TimeTolerance1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "TimeToleranceLimit1"
msgstr "Time Tolerance Limit 1"

msgid "TimeToleranceLimit1_DEFINITION"
msgstr "The current limit in x In limiting the application of [[TimeTolerance1]], if any. If the value is set to 0, the value of the [[TimeTolerance1]] is valid for the whole time/current-curve."

msgid "TimeToleranceLimit1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "TimeTolerance2"
msgstr "Time Tolerance 2"

msgid "TimeTolerance2_DEFINITION"
msgstr "The tolerance for the time of the time/current-curve in % valid for currents above [[TimeToleranceLimit1]]."

msgid "TimeTolerance2_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveRatioMeasure as value."

msgid "IsTimeTolerancePositiveOnly"
msgstr "Is Time Tolerance Positive Only"

msgid "IsTimeTolerancePositiveOnly_DEFINITION"
msgstr "Indication whether the value of [[TimeTolerance1]] is provided as a positive tolereance only or not. If not, the value is proved as a pluss/minus tolerance."

msgid "IsTimeTolerancePositiveOnly_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "ReleaseCurrentI2tStart"
msgstr "Release Current I2t Start"

msgid "ReleaseCurrentI2tStart_DEFINITION"
msgstr "The release current in x In."

msgid "ReleaseCurrentI2tStart_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "ReleaseTimeI2tStart"
msgstr "Release Time I2t Start"

msgid "ReleaseTimeI2tStart_DEFINITION"
msgstr "The release time in s."

msgid "ReleaseTimeI2tStart_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "ReleaseCurrentI2tEnd"
msgstr "Release Current I2t End"

msgid "ReleaseCurrentI2tEnd_DEFINITION"
msgstr "The release current in x In."

msgid "ReleaseCurrentI2tEnd_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "ReleaseTimeI2tEnd"
msgstr "Release Time I2t End"

msgid "ReleaseTimeI2tEnd_DEFINITION"
msgstr "The release time in s."

msgid "ReleaseTimeI2tEnd_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "MaxAdjustmentX_ICS"
msgstr "Max Adjustment X ICS"

msgid "MaxAdjustmentX_ICS_DEFINITION"
msgstr "Provides the maximum setting value for the available current adjustment in relation to the Ics breaking capacity of the protection device of which the actual tripping unit is a part of. The value is not asserted unless the instantaneous time protection is."

msgid "MaxAdjustmentX_ICS_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "IsOffWhenSFunctionOn"
msgstr "Is Off When S-Function On"

msgid "IsOffWhenSFunctionOn_DEFINITION"
msgstr "Indication whether the I-function is automatically switched off when the S-function is switched on."

msgid "IsOffWhenSFunctionOn_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "UpperCurrent1"
msgstr "Upper Current 1"

msgid "UpperCurrent1_DEFINITION"
msgstr "The current in x In, indicating that for currents larger than [[UpperCurrent1]] the I2t part of the L-function will trip the current."

msgid "UpperCurrent1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "UpperCurrent2"
msgstr "Upper Current 2"

msgid "UpperCurrent2_DEFINITION"
msgstr "The current in x In, indicating the upper current limit of the upper time/current curve of the I2t part of the L-function."

msgid "UpperCurrent2_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "UpperTime1"
msgstr "Upper Time 1"

msgid "UpperTime1_DEFINITION"
msgstr "The time in s, indicating that tripping times of the upper time/current curve lower than [[UpperTime1]] is determined by the I2t part of the L-function."

msgid "UpperTime1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "UpperTime2"
msgstr "Upper Time 2"

msgid "UpperTime2_DEFINITION"
msgstr "The time in s, indicating the tripping times of the upper time/current curve at the [[UpperCurrent2]]."

msgid "UpperTime2_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "LowerCurrent1"
msgstr "Lower Current 1"

msgid "LowerCurrent1_DEFINITION"
msgstr "The current in x In, indicating that for currents smaller than [[LowerCurrent1]] the I2t part of the L-function will not trip the current,."

msgid "LowerCurrent1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "LowerCurrent2"
msgstr "Lower Current 2"

msgid "LowerCurrent2_DEFINITION"
msgstr "The current in x In, indicating the upper current limit of the lower time/current curve of the I2t part of the L-function."

msgid "LowerCurrent2_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "LowerTime1"
msgstr "Lower Time 1"

msgid "LowerTime1_DEFINITION"
msgstr "The time in s, indicating that tripping times of the lower time/current curve lower than [[LowerTime1]] is determined by the I2t part of the L-function."

msgid "LowerTime1_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "LowerTime2"
msgstr "Lower Time 2"

msgid "LowerTime2_DEFINITION"
msgstr "The time in s, indicating the tripping times of the upper time/current curve at the [[LowerCurrent2]]."

msgid "LowerTime2_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "IsOffWhenLfunctionOn"
msgstr "Is Off When L-Function On"

msgid "IsOffWhenLfunctionOn_DEFINITION"
msgstr "Indication whether the S-function is automatically switched off when the I-function is switched on."

msgid "IsOffWhenLfunctionOn_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "AdjustmentValueType"
msgstr "Adjustment Value Type"

msgid "AdjustmentValueType_DEFINITION"
msgstr "The type of adjustment value that is applied through the property set. This determines the properties that should be asserted (see below)."

msgid "AdjustmentValueType_LIST"
msgstr "List"

msgid "AdjustmentValueType_RANGE"
msgstr "Range"

msgid "CurrentAdjustmentRange"
msgstr "Current Adjustment Range"

msgid "CurrentAdjustmentRange_DEFINITION"
msgstr "Upper and lower current adjustment limits for an [[AdjustmentValueType]] = [[RANGE]]. Note that this property should not have a value for an [[AdjustmentValueType]] = [[LIST]]."

msgid "CurrentAdjustmentRangeStepValue"
msgstr "Current Adjustment Range Step Value"

msgid "CurrentAdjustmentRangeStepValue_DEFINITION"
msgstr "Step value of current adjustment for an [[AdjustmentValueType]] = [[RANGE]]. Note that this property should not have a value for an [[AdjustmentValueType]] = [[LIST]]."

msgid "CurrentAdjustmentRangeStepValue_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "CurrentAdjustmentValues"
msgstr "Current Adjustment Values"

msgid "CurrentAdjustmentValues_DEFINITION"
msgstr "A list of current adjustment values that may be applied to a tripping unit for an [[AdjustmentValueType]] = [[LIST]]. A minimum of 1 and a maximum of 16 adjustment values may be specified. Note that this property should not have a value for an [[AdjustmentValueType]] = [[RANGE]]."

msgid "AdjustmentDesignation"
msgstr "Adjustment Designation"

msgid "AdjustmentDesignation_DEFINITION"
msgstr "The desgnation on the device for the adjustment."

msgid "AdjustmentDesignation_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "TimeAdjustmentRange"
msgstr "Time Adjustment Range"

msgid "TimeAdjustmentRange_DEFINITION"
msgstr "Upper and lower time adjustment limits for an [[AdjustmentValueType]] = [[RANGE]]. Note that this property should not have a value for an [[AdjustmentValueType]] = [[LIST]]."

msgid "TimeAdjustmentRangeStepValue"
msgstr "Time Adjustment Range Step Value"

msgid "TimeAdjustmentRangeStepValue_DEFINITION"
msgstr "Step value of time adjustment for an [[AdjustmentValueType]] = [[RANGE]]. Note that this property should not have a value for an [[AdjustmentValueType]] = [[LIST]]."

msgid "TimeAdjustmentRangeStepValue_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "TimeAdjustmentValues"
msgstr "Time Adjustment Values"

msgid "TimeAdjustmentValues_DEFINITION"
msgstr "A list of time adjustment values that may be applied to a tripping unit for an [[AdjustmentValueType]] = [[LIST]]. A minimum of 1 and a maximum of 16 adjustment values may be specified. Note that this property should not have a value for an [[AdjustmentValueType]] = [[RANGE]]."

msgid "CurrentForTimeDelay"
msgstr "Current for Time Delay"

msgid "CurrentForTimeDelay_DEFINITION"
msgstr "The tripping current in x In at which the time delay is specified. A value for this property should only be asserted for time delay of L-function, and for I2t of the S and G function."

msgid "CurrentForTimeDelay_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcTimeMeasure as value."

msgid "I2TApplicability"
msgstr "I2t Applicability"

msgid "I2TApplicability_DEFINITION"
msgstr "The applicability of the time adjustment related to the tripping function."

msgid "I2TApplicability_LIST"
msgstr "List"

msgid "I2TApplicability_RANGE"
msgstr "Range"

msgid "Standard"
msgstr "Standard"

msgid "Standard_DEFINITION"
msgstr "The designation of the standard applicable for the definition of the object used."

msgid "Standard_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "UseInDiscrimination"
msgstr "Use In Discrimination"

msgid "UseInDiscrimination_DEFINITION"
msgstr "An indication whether the time/current tripping information can be applied in a discrimination analysis or not."

msgid "UseInDiscrimination_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "AtexVerified"
msgstr "Atex Verified"

msgid "AtexVerified_DEFINITION"
msgstr "An indication whether the tripping_unit is verified to be applied in EX-environment or not."

msgid "AtexVerified_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "OldDevice"
msgstr "Old Device"

msgid "OldDevice_DEFINITION"
msgstr "Indication whether the protection_ unit is out-dated or not. If not out-dated, the device is still for sale."

msgid "OldDevice_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "LimitingTerminalSize"
msgstr "Limiting Terminal Size"

msgid "LimitingTerminalSize_DEFINITION"
msgstr "The maximum terminal size capacity of the device."

msgid "LimitingTerminalSize_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcAreaMeasure as value."

msgid "IfcAudioVisualAppliance"
msgstr "Audio Visual Appliance"

msgid "IfcAudioVisualAppliance_DEFINITION"
msgstr "An audio-visual appliance is a device that displays, captures, transmits, or receives audio or video."

msgid "PowerState"
msgstr "Power State"

msgid "PowerState_DEFINITION"
msgstr "Indicates the power state of the device where True is on and False is off."

msgid "PowerState_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "MediaSourceHistory"
msgstr "Media Source History"

msgid "MediaSourceHistory_DEFINITION"
msgstr "Indicates the media source where the identifier corresponds to an entry within the table of available media sources on [[Pset_AudioVisualApplianceTypeCommon]].[[MediaSource]]."

msgid "MediaSourceHistory_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "MediaContent"
msgstr "Media Content"

msgid "MediaContent_DEFINITION"
msgstr "Indicates the media content storage location, such as URLs to camera footage within particular time periods."

msgid "MediaContent_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "AudioVolumeHistory"
msgstr "Audio Volume History"

msgid "AudioVolumeHistory_DEFINITION"
msgstr "Indicates the audio volume level where the integer level corresponds to an entry or interpolation within [[Pset_AudioVisualApplianceTypeCommon]].[[AudioVolume]]."

msgid "AudioVolumeHistory_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "MediaSource"
msgstr "Media Source"

msgid "MediaSource_DEFINITION"
msgstr "Indicates media sources and corresponding names of ports ([[IfcDistributionPort]] with FlowDirection=SINK and PredefinedType=AUDIOVISUAL) or aggregated audio/video components ([[IfcAudioVisualAppliance]])."

msgid "MediaSource_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes a table as its value. That table has two "

msgid "AudioVolume"
msgstr "Audio Volume"

msgid "AudioVolume_DEFINITION"
msgstr "Indicates discrete audio volume levels and corresponding sound power offsets, if applicable. Missing values may be interpolated."

msgid "AudioVolume_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes a table as its value. That table has two "

msgid "IfcCableCarrierFitting"
msgstr "Cable Carrier Fitting"

msgid "IfcCableCarrierFitting_DEFINITION"
msgstr "A cable carrier fitting is a fitting that is placed at junction or transition in a cable carrier system."

msgid "IfcCableCarrierSegment"
msgstr "Cable Carrier Segment"

msgid "IfcCableCarrierSegment_DEFINITION"
msgstr "A cable carrier segment is a flow segment that is specifically used to carry and support cabling."

msgid "CrossSectionArea"
msgstr "Cross Section Area"

msgid "CrossSectionArea_DEFINITION"
msgstr "Total area of the cross section (or profile) of the object."

msgid "NumberOfCrossedTracks"
msgstr "Number of Crossed Tracks"

msgid "NumberOfCrossedTracks_DEFINITION"
msgstr "Number of tracks crossed in cable route."

msgid "NumberOfCrossedTracks_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcCountMeasure as value."

msgid "IfcCableFitting"
msgstr "Cable Fitting"

msgid "IfcCableFitting_DEFINITION"
msgstr "A cable fitting is a fitting that is placed at a junction, transition or termination in a cable system."

msgid "Attenuation"
msgstr "Attenuation"

msgid "Attenuation_DEFINITION"
msgstr "Indicates the optical or electrical attenuation of the cable measured in dB, at a certain wavelength or frequency, changing with the length of the cable."

msgid "Attenuation_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcReal as value."

msgid "IsFireResistant"
msgstr "Is Fire Resistant"

msgid "IsFireResistant_DEFINITION"
msgstr "Indicates whether the cable is fire resistant."

msgid "IsFireResistant_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "JacketColour"
msgstr "Jacket Colour"

msgid "JacketColour_DEFINITION"
msgstr "Indicates the colour of the cable or fitting jacket."

msgid "JacketColour_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "CableFunctionType"
msgstr "Cable Function Type"

msgid "CableFunctionType_DEFINITION"
msgstr "Distinguishes between Telecom and [[Power]] Supply cables."

msgid "CableFunctionType_POWERSUPPLY"
msgstr "[[Power]] Supply"

msgid "CableFunctionType_TELECOMMUNICATION"
msgstr "Telecommunication"

msgid "CableFunctionType_OTHER"
msgstr "Other"

msgid "CableFunctionType_NOTKNOWN"
msgstr "Not Known"

msgid "CableFunctionType_UNSET"
msgstr "Unset"

msgid "CableArmourType"
msgstr "Cable Armour Type"

msgid "CableArmourType_DEFINITION"
msgstr "The armour type of the cable for mechanical protection."

msgid "CableArmourType_DIELECTRIC"
msgstr "Dielectric"

msgid "CableArmourType_METALLIC"
msgstr "Metallic"

msgid "CableArmourType_OTHER"
msgstr "Other"

msgid "CableArmourType_NOTKNOWN"
msgstr "Not Known"

msgid "CableArmourType_UNSET"
msgstr "Unset"

msgid "IfcCableSegment"
msgstr "Cable Segment"

msgid "IfcCableSegment_DEFINITION"
msgstr "A cable segment is a flow segment used to carry electrical power, data, or telecommunications signals."

msgid "DesignAmbientTemperature"
msgstr "Design Ambient Temperature"

msgid "DesignAmbientTemperature_DEFINITION"
msgstr "The highest and lowest local ambient temperature likely to be encountered."

msgid "UserCorrectionFactor"
msgstr "User Correction Factor"

msgid "UserCorrectionFactor_DEFINITION"
msgstr "An arbitrary correction factor that may be applied by the user."

msgid "UserCorrectionFactor_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcReal as value."

msgid "NumberOfParallelCircuits"
msgstr "Number of Parallel Circuits"

msgid "NumberOfParallelCircuits_DEFINITION"
msgstr "Number of parallel circuits."

msgid "NumberOfParallelCircuits_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcCountMeasure as value."

msgid "InstallationMethod"
msgstr "Installation Method"

msgid "InstallationMethod_DEFINITION"
msgstr "Method of installation of cable/conductor. Installation methods are typically defined by reference in standards such as IEC 60364-5-52, table 52A-1 or BS7671 Appendix 4 Table 4A1 etc. Selection of the value to be used should be determined from such a standard according to local usage."

msgid "InstallationMethod_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "InstallationMethodFlagEnum"
msgstr "Installation Method Flag Enum"

msgid "InstallationMethodFlagEnum_DEFINITION"
msgstr "2001 reference installation methods C and D."

msgid "InstallationMethodFlagEnum_BELOWCEILING"
msgstr "Below Ceiling"

msgid "InstallationMethodFlagEnum_INDUCT"
msgstr "Induct"

msgid "InstallationMethodFlagEnum_INSOIL"
msgstr "In Soil"

msgid "InstallationMethodFlagEnum_ONWALL"
msgstr "On Wall"

msgid "InstallationMethodFlagEnum_OTHER"
msgstr "Other"

msgid "InstallationMethodFlagEnum_NOTKNOWN"
msgstr "Not Known"

msgid "InstallationMethodFlagEnum_UNSET"
msgstr "Unset"

msgid "DistanceBetweenParallelCircuits"
msgstr "Distance Between Parallel Circuits"

msgid "DistanceBetweenParallelCircuits_DEFINITION"
msgstr "Distance measured between parallel circuits."

msgid "DistanceBetweenParallelCircuits_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLengthMeasure as value."

msgid "SoilConductivity"
msgstr "Soil Conductivity"

msgid "SoilConductivity_DEFINITION"
msgstr "Thermal conductivity of soil. Generally, within standards such as IEC 60364-5-52, table 52A-16, the resistivity of soil is required (measured in SI units of degK.m /W). This is the reciprocal of the conductivity value and needs to be calculated accordingly."

msgid "SoilConductivity_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermalConductivityMeasure as value."

msgid "CarrierStackNumber"
msgstr "Carrier Stack Number"

msgid "CarrierStackNumber_DEFINITION"
msgstr "Number of carrier segments (tray, ladder etc.) that are vertically stacked (vertical is measured as the z-axis of the local coordinate system of the carrier segment)."

msgid "CarrierStackNumber_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcInteger as value."

msgid "MountingMethod"
msgstr "Mounting Method"

msgid "MountingMethod_DEFINITION"
msgstr "The method of mounting cable segment occurrences on a cable carrier occurrence from which the method required can be selected. This is for the purpose of carrying out 'worst case' cable sizing calculations and may be a conceptual requirement rather than a statement of the physical occurrences of cable and carrier segments."

msgid "MountingMethod_LADDER"
msgstr "Ladder"

msgid "MountingMethod_PERFORATEDTRAY"
msgstr "Perforated Tray"

msgid "MountingMethod_OTHER"
msgstr "Other"

msgid "MountingMethod_NOTKNOWN"
msgstr "Not Known"

msgid "MountingMethod_UNSET"
msgstr "Unset"

msgid "IsHorizontalCable"
msgstr "Is Horizontal Cable"

msgid "IsHorizontalCable_DEFINITION"
msgstr "Indication of whether the cable occurrences are mounted horizontally (= TRUE) or vertically (= FALSE)."

msgid "IsHorizontalCable_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "IsMountedFlatCable"
msgstr "Is Mounted Flat Cable"

msgid "IsMountedFlatCable_DEFINITION"
msgstr "Indication of whether the cable occurrences are mounted flat (= TRUE) or in a trefoil pattern (= FALSE)."

msgid "IsMountedFlatCable_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "CurrentCarryingCapacity"
msgstr "Current Carrying Capacity"

msgid "CurrentCarryingCapacity_DEFINITION"
msgstr "Maximum value of electric current which can be carried continuously by a conductor, a device or an apparatus, under specified conditions without its steady-state temperature exceeding a specified value. Based on IEC60826-11-13.The temperature specified value is maximum Design Ambient [[Temperature]]."

msgid "CurrentCarryingCapacity_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcElectricCurrentMeasure as value."

msgid "MaximumCableLength"
msgstr "Maximum Cable Length"

msgid "MaximumCableLength_DEFINITION"
msgstr "Maximum cable length based on voltagedrop.This value may also be specified as a constraint within an IFC model if required but is included within the property set at this stage pending implementation of the required capabilities within software applications."

msgid "MaximumCableLength_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLengthMeasure as value."

msgid "PowerLoss"
msgstr "Power Loss"

msgid "PowerLoss_DEFINITION"
msgstr "The power loss in W."

msgid "PowerLoss_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPowerMeasure as value."

msgid "SequentialCode"
msgstr "Sequential Code"

msgid "SequentialCode_DEFINITION"
msgstr "Indicates the sequential code of the cable or wire."

msgid "SequentialCode_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "ConnectorAColour"
msgstr "Connector A Colour"

msgid "ConnectorAColour_DEFINITION"
msgstr "Indicates the colour A- end of connector."

msgid "ConnectorAColour_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "ConnectorBColour"
msgstr "Connector B Colour"

msgid "ConnectorBColour_DEFINITION"
msgstr "Indicates the colour B- end of connector."

msgid "ConnectorBColour_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "ConnectorAType"
msgstr "Connector A Type"

msgid "ConnectorAType_DEFINITION"
msgstr "Indicates the type of A-end connector."

msgid "ConnectorAType_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "ConnectorBType"
msgstr "Connector B Type"

msgid "ConnectorBType_DEFINITION"
msgstr "Indicates the type of B-end connector."

msgid "ConnectorBType_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcLabel as value."

msgid "ConnectorAGender"
msgstr "Connector A Gender"

msgid "ConnectorAGender_DEFINITION"
msgstr "Indicates the gender of A-end connector."

msgid "ConnectorAGender_FEMALE"
msgstr "Female"

msgid "ConnectorAGender_MALE"
msgstr "Male"

msgid "ConnectorAGender_OTHER"
msgstr "Other"

msgid "ConnectorAGender_NOTKNOWN"
msgstr "Not Known"

msgid "ConnectorAGender_UNSET"
msgstr "Unset"

msgid "ConnectorBGender"
msgstr "Connector B Gender"

msgid "ConnectorBGender_DEFINITION"
msgstr "Indicates the gender of B-end connector."

msgid "ConnectorBGender_FEMALE"
msgstr "Female"

msgid "ConnectorBGender_MALE"
msgstr "Male"

msgid "ConnectorBGender_OTHER"
msgstr "Other"

msgid "ConnectorBGender_NOTKNOWN"
msgstr "Not Known"

msgid "ConnectorBGender_UNSET"
msgstr "Unset"

msgid "IfcCommunicationsAppliance"
msgstr "Communications Appliance"

msgid "IfcCommunicationsAppliance_DEFINITION"
msgstr "A communications appliance transmits and receives electronic or digital information as data or sound."

msgid "IfcDistributionBoard"
msgstr "Distribution Board"

msgid "IfcDistributionBoard_DEFINITION"
msgstr "A distribution board is a flow controller in which instances of electrical or communication devices are brought together at a single place for a particular purpose."

msgid "IfcElectricAppliance"
msgstr "Electric Appliance"

msgid "IfcElectricAppliance_DEFINITION"
msgstr "An electric appliance is a device intended for consumer usage that is powered by electricity."

msgid "IfcElectricFlowStorageDevice"
