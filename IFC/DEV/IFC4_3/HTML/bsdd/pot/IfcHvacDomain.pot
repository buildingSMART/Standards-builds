msgstr "Convex Convex"

msgid "EndShapeType_FLATCONVEX"
msgstr "Flat Convex"

msgid "EndShapeType_FLATFLAT"
msgstr "Flat Flat"

msgid "EndShapeType_OTHER"
msgstr "Other"

msgid "EndShapeType_NOTKNOWN"
msgstr "Not Known"

msgid "EndShapeType_UNSET"
msgstr "The [[Value]] Unset Should Be Used"

msgid "FirstCurvatureRadius"
msgstr "First Curvature Radius"

msgid "FirstCurvatureRadius_DEFINITION"
msgstr "[[FirstCurvatureRadius]] should be defined as the base or left side radius of curvature value."

msgid "FirstCurvatureRadius_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "SecondCurvatureRadius"
msgstr "Second Curvature Radius"

msgid "SecondCurvatureRadius_DEFINITION"
msgstr "[[SecondCurvatureRadius]] should be defined as the top or right side radius of curvature value."

msgid "SecondCurvatureRadius_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "SectionLength"
msgstr "Section Length"

msgid "SectionLength_DEFINITION"
msgstr "The length of a section used in the construction of the tank."

msgid "SectionLength_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "SectionWidth"
msgstr "Section Width"

msgid "SectionWidth_DEFINITION"
msgstr "The width of a section used in the construction of the tank."

msgid "SectionWidth_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "IfcTubeBundle"
msgstr "Tube Bundle"

msgid "IfcTubeBundle_DEFINITION"
msgstr "A tube bundle is a device consisting of tubes and bundles of tubes used for heat transfer and contained typically within other energy conversion devices, such as a chiller or coil."

msgid "NumberOfRows"
msgstr "Number of Rows"

msgid "NumberOfRows_DEFINITION"
msgstr "Number of tube rows in the tube bundle assembly."

msgid "NumberOfRows_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcCountMeasure as value."

msgid "StaggeredRowSpacing"
msgstr "Staggered Row Spacing"

msgid "StaggeredRowSpacing_DEFINITION"
msgstr "Staggered tube row spacing."

msgid "StaggeredRowSpacing_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "InLineRowSpacing"
msgstr "In Line Row Spacing"

msgid "InLineRowSpacing_DEFINITION"
msgstr "In-line tube row spacing."

msgid "InLineRowSpacing_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "NumberOfCircuits"
msgstr "Number of Circuits"

msgid "NumberOfCircuits_DEFINITION"
msgstr "Number of circuits."

msgid "NumberOfCircuits_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcCountMeasure as value."

msgid "FoulingFactor"
msgstr "Fouling Factor"

msgid "FoulingFactor_DEFINITION"
msgstr "Fouling factor of the tubes in the tube bundle."

msgid "FoulingFactor_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcThermalResistanceMeasure as value."

msgid "Volume"
msgstr "Volume"

msgid "Volume_DEFINITION"
msgstr "[[Volume]] of the element."

msgid "Volume_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcVolumeMeasure as value."

msgid "OutsideDiameter"
msgstr "Outside Diameter"

msgid "OutsideDiameter_DEFINITION"
msgstr "Actual outside diameter of the tube in the tube bundle."

msgid "OutsideDiameter_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "InsideDiameter"
msgstr "Inside Diameter"

msgid "InsideDiameter_DEFINITION"
msgstr "Actual inner diameter of the tube in the tube bundle."

msgid "InsideDiameter_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "HorizontalSpacing"
msgstr "Horizontal Spacing"

msgid "HorizontalSpacing_DEFINITION"
msgstr "Horizontal spacing between tubes in the tube bundle."

msgid "HorizontalSpacing_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "VerticalSpacing"
msgstr "Vertical Spacing"

msgid "VerticalSpacing_DEFINITION"
msgstr "Vertical spacing between tubes in the tube bundle."

msgid "VerticalSpacing_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "HasTurbulator"
msgstr "Has Turbulator"

msgid "HasTurbulator_DEFINITION"
msgstr "TRUE if the tube has a turbulator, FALSE if it does not."

msgid "HasTurbulator_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcBoolean as value."

msgid "IfcUnitaryEquipment"
msgstr "Unitary Equipment"

msgid "IfcUnitaryEquipment_DEFINITION"
msgstr "Unitary equipment typically combine a number of components into a single product, such as air handlers, pre-packaged rooftop air-conditioning units, heat pumps, and split systems."

msgid "IfcValve"
msgstr "Valve"

msgid "IfcValve_DEFINITION"
msgstr "A valve is used in a building services piping distribution system to control or modulate the flow of the fluid."

msgid "PercentageOpen"
msgstr "Percentage Open"

msgid "PercentageOpen_DEFINITION"
msgstr "The ratio between the amount that the valve is open to the full open position of the valve."

msgid "PercentageOpen_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "MeasuredFlowRate"
msgstr "Measured Flow Rate"

msgid "MeasuredFlowRate_DEFINITION"
msgstr "The rate of flow of a fluid measured across the valve."

msgid "MeasuredFlowRate_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "MeasuredPressureDrop"
msgstr "Measured Pressure Drop"

msgid "MeasuredPressureDrop_DEFINITION"
msgstr "The actual pressure drop in the fluid measured across the valve."

msgid "MeasuredPressureDrop_DESCRIPTION"
msgstr "Technical note: this is a specific property from IFC that takes as its value a reference to IfcTimeSeries."

msgid "ValvePattern"
msgstr "Valve Pattern"

msgid "ValvePattern_DEFINITION"
msgstr "Valve that has a single entry port from the system that it serves, the exit port being to the surrounding environment.;Valve in which the direction of flow is changed through 90 degrees.;Valve in which the flow is straight through.;Valve with three separate ports.;Valve with 4 separate ports."

msgid "ValvePattern_ANGLED_2_PORT"
msgstr "Angled 2 Port: Valve In Which The [[Direction]] of Flow Is Changed Through 90 Degrees"

msgid "ValvePattern_CROSSOVER_4_PORT"
msgstr "Crossover 4 Port: Valve with 4 Separate Ports"

msgid "ValvePattern_SINGLEPORT"
msgstr "The Configuration of The Ports of A Valve According to Either The Linear Route Taken By A Fluid Flowing Through The Valve or By The Number of Ports Where: Singleport: Valve That Has A Single Entry Port From The System That It Serves"

msgid "ValvePattern_STRAIGHT_2_PORT"
msgstr "Straight 2 Port: Valve In Which The Flow Is Straight Through"

msgid "ValvePattern_STRAIGHT_3_PORT"
msgstr "Straight 3 Port: Valve with Three Separate Ports"

msgid "ValvePattern_OTHER"
msgstr "Other"

msgid "ValvePattern_NOTKNOWN"
msgstr "Not Known"

msgid "ValvePattern_UNSET"
msgstr "Unset"

msgid "ValveOperation"
msgstr "Valve Operation"

msgid "ValveOperation_DEFINITION"
msgstr "A valve that is closed by the action of a weighted lever being released, the weight normally being prevented from dropping by being held by a wire, the closure normally being made by the action of heat on a fusible link in the wire;A valve that is opened and closed by the action of a float that rises and falls with water level. The float may be a ball attached to a lever or other mechanism;A valve that is opened and closed by hydraulic actuation;A valve that is opened and closed by the action of a lever rotating the gate within the valve.;A valve that requires the use of a special lockshield key for opening and closing, the operating mechanism being protected by a shroud during normal operation.;A valve that is opened and closed by the action of an electric motor on an actuator;A valve that is opened and closed by pneumatic actuation;A valve that is normally held open by a magnetic field in a coil acting on the gate but that is closed immediately if the electrical current generating the magnetic field is removed.;A valve that is normally held in position by the pressure of a spring on a plate but that may be caused to open if the pressure of the fluid is sufficient to overcome the spring pressure.;A valve in which the ports are opened or closed to maintain a required predetermined temperature.;A valve that is opened and closed by the action of a wheel moving the gate within the valve."

msgid "ValveOperation_DROPWEIGHT"
msgstr "The Method of Valve [[Operation]] Where: Dropweight: A Valve That Is Closed By The Action of A Weighted Lever Being Released"

msgid "ValveOperation_FLOAT"
msgstr "The Closure Normally Being Made By The Action of [[Heat]] On A Fusible Link In The Wire Float: A Valve That Is Opened and Closed By The Action of A Float That Rises and Falls with [[Water]] Level"

msgid "ValveOperation_HYDRAULIC"
msgstr "The Float May Be A Ball Attached to A Lever or Other Mechanism Hydraulic: A Valve That Is Opened and Closed By Hydraulic Actuation Lever: A Valve That Is Opened and Closed By The Action of A Lever Rotating The Gate Within The Valve"

msgid "ValveOperation_LEVER"
msgstr "The Method of Valve [[Operation]] Where: Dropweight: A Valve That Is Closed By The Action of A Weighted Lever Being Released"

msgid "ValveOperation_LOCKSHIELD"
msgstr "Lockshield: A Valve That Requires The Use of A Special Lockshield Key for Opening and Closing"

msgid "ValveOperation_MOTORIZED"
msgstr "Motorized: A Valve That Is Opened and Closed By The Action of An Electric Motor On An Actuator Pneumatic: A Valve That Is Opened and Closed By Pneumatic Actuation Solenoid: A Valve That Is Normally Held Open By A Magnetic Field In A Coil Acting On The Gate But That Is Closed Immediately If The Electrical Current Generating The Magnetic Field Is Removed"

msgid "ValveOperation_PNEUMATIC"
msgstr "Motorized: A Valve That Is Opened and Closed By The Action of An Electric Motor On An Actuator Pneumatic: A Valve That Is Opened and Closed By Pneumatic Actuation Solenoid: A Valve That Is Normally Held Open By A Magnetic Field In A Coil Acting On The Gate But That Is Closed Immediately If The Electrical Current Generating The Magnetic Field Is Removed"

msgid "ValveOperation_SOLENOID"
msgstr "Motorized: A Valve That Is Opened and Closed By The Action of An Electric Motor On An Actuator Pneumatic: A Valve That Is Opened and Closed By Pneumatic Actuation Solenoid: A Valve That Is Normally Held Open By A Magnetic Field In A Coil Acting On The Gate But That Is Closed Immediately If The Electrical Current Generating The Magnetic Field Is Removed"

msgid "ValveOperation_SPRING"
msgstr "Spring: A Valve That Is Normally Held In Position By The Pressure of A Spring On A Plate But That May Be Caused to Open If The Pressure of The Fluid Is Sufficient to Overcome The Spring Pressure"

msgid "ValveOperation_THERMOSTATIC"
msgstr "Thermostatic: A Valve In Which The Ports Are Opened or Closed to Maintain A Required Predetermined [[Temperature]]"

msgid "ValveOperation_WHEEL"
msgstr "Wheel: A Valve That Is Opened and Closed By The Action of A Wheel Moving The Gate Within The Valve"

msgid "ValveOperation_OTHER"
msgstr "The Float May Be A Ball Attached to A Lever or Other Mechanism Hydraulic: A Valve That Is Opened and Closed By Hydraulic Actuation Lever: A Valve That Is Opened and Closed By The Action of A Lever Rotating The Gate Within The Valve"

msgid "ValveOperation_NOTKNOWN"
msgstr "Not Known"

msgid "ValveOperation_UNSET"
msgstr "Unset"

msgid "ValveMechanism"
msgstr "Valve Mechanism"

msgid "ValveMechanism_DEFINITION"
msgstr "Valve that has a ported ball that can be turned relative to the body seat ports.;Valve in which a streamlined disc pivots about a diametric axis.;Screwdown valve in which the closing gate is shaped in a configured manner to have a more precise control of pressure and flow change across the valve.;Valve with a tapered seating, in which a rotatable plug is retained by means of a gland and gland packing.;Screwdown valve that has a spherical body.;Plug valve in which a lubricant is injected under pressure between the plug face and the body.;Valve for regulating the flow in or from a pipe, in which a slender cone moves along the axis of flow to close against a fixed conical seat.;Screwdown valve that has a machined plate that slides in formed grooves to form a seal.;Valve that has a ported plug that can be turned relative to the body seat ports.;Screwdown valve that has a wedge shaped plate fitting into tapered guides to form a seal."

msgid "ValveMechanism_BALL"
msgstr "The Mechanism By Which The Valve Function Is Achieved Where: Ball: Valve That Has A Ported Ball That Can Be Turned Relative to The Body Seat Ports"

msgid "ValveMechanism_BUTTERFLY"
msgstr "Butterfly: Valve In Which A Streamlined Disc Pivots About A Diametric Axis"

msgid "ValveMechanism_CONFIGUREDGATE"
msgstr "Configuredgate: Screwdown Valve In Which The Closing Gate Is Shaped In A Configured Manner to Have A More Precise Control of Pressure and Flow Change Across The Valve"

msgid "ValveMechanism_GLAND"
msgstr "Gland: Valve with A Tapered Seating"

msgid "ValveMechanism_GLOBE"
msgstr "Globe: Screwdown Valve That Has A Spherical Body"

msgid "ValveMechanism_LUBRICATEDPLUG"
msgstr "Lubricatedplug: Plug Valve In Which A Lubricant Is Injected Under Pressure Between The Plug Face and The Body"

msgid "ValveMechanism_NEEDLE"
msgstr "Needle: Valve for Regulating The Flow In or From A Pipe"

msgid "ValveMechanism_PARALLELSLIDE"
msgstr "Parallelslide: Screwdown Valve That Has A Machined Plate That Slides In Formed Grooves to Form A Seal"

msgid "ValveMechanism_PLUG"
msgstr "In Which A Rotatable Plug Is Retained By Means of A Gland and Gland Packing"

msgid "ValveMechanism_WEDGEGATE"
msgstr "Wedgegate: Screwdown Valve That Has A Wedge Shaped Plate Fitting Into Tapered Guides to Form A Seal"

msgid "ValveMechanism_OTHER"
msgstr "Other"

msgid "ValveMechanism_NOTKNOWN"
msgstr "Not Known"

msgid "ValveMechanism_UNSET"
msgstr "Unset"

msgid "Size"
msgstr "Size"

msgid "Size_DEFINITION"
msgstr "The size of the connection to the valve (or to each connection for faucets, mixing valves, etc.)."

msgid "Size_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPositiveLengthMeasure as value."

msgid "TestPressure"
msgstr "Test Pressure"

msgid "TestPressure_DEFINITION"
msgstr "The maximum pressure to which the valve has been subjected under test."

msgid "TestPressure_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcPressureMeasure as value."

msgid "FlowCoefficient"
msgstr "Flow Coefficient"

msgid "FlowCoefficient_DEFINITION"
msgstr "Flow coefficient (the quantity of fluid that passes through a fully open valve at unit pressure drop), typically expressed as the Kv or Cv value for the valve."

msgid "FlowCoefficient_DESCRIPTION"
msgstr "Technical note: in IFC this property takes IfcReal as value."

